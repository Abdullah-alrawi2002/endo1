# Required on the hosted server (visitors never see this).
# Get a key at https://platform.openai.com/api-keys
# Never commit .env
OPENAI_API_KEY=

ENDO_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

ENABLE_CORRECTION_RAG=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.78
CORRECTIONS_JSON_PATH=data/corrections.json

# Keep off until CT sidecar is deployed (see SHARE.md — CT for everyone)
ENABLE_CT_MODULE=false
# Public URL of the Railway CT service (required when ENABLE_CT_MODULE=true)
# CT_SIDECAR_URL=https://your-ct-service.up.railway.app
CT_ANALYSIS_TIMEOUT_MS=1800000
CT_VISION_MODEL=gpt-4o
CT_ASSUME_CALIBRATED_HU=false
CT_ANALYSIS_STORE_PATH=data/ct-analyses
