# Required — get a key at https://platform.openai.com/api-keys
# Never commit .env (only this .env.example is in git).
OPENAI_API_KEY=

# Default chat model — pin after evaluation on your locked clinical set.
ENDO_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Optional: OpenAI-compatible base URL
# OPENAI_BASE_URL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.78
CORRECTIONS_DB_PATH=data/corrections.db

# --- Clinical MVP feature flags (CT + RAG OFF by default) ---
# First defensible release is clinical-only, AAE_2009, able to abstain.
ENABLE_CT_MODULE=false
ENABLE_CORRECTION_RAG=false

# --- CT research module (only when ENABLE_CT_MODULE=true) ---
CT_SIDECAR_URL=http://127.0.0.1:8000
CT_ANALYSIS_TIMEOUT_MS=1800000
CT_VISION_MODEL=gpt-4o
CT_ASSUME_CALIBRATED_HU=false
CT_ANALYSIS_STORE_PATH=data/ct-analyses
