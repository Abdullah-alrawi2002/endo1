# Required — get a key at https://platform.openai.com/api-keys
# Never commit .env (only this .env.example is in git).
OPENAI_API_KEY=

# Chat model for all diagnosis stages (pin after evaluation).
ENDO_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Optional: OpenAI-compatible base URL
# OPENAI_BASE_URL=

# Correction RAG (ON by default — set to false to disable)
ENABLE_CORRECTION_RAG=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.78
CORRECTIONS_DB_PATH=data/corrections.db

# CT research module (OFF by default — not part of the core plan MVP)
ENABLE_CT_MODULE=false
CT_SIDECAR_URL=http://127.0.0.1:8000
CT_ANALYSIS_TIMEOUT_MS=1800000
CT_VISION_MODEL=gpt-4o
CT_ASSUME_CALIBRATED_HU=false
CT_ANALYSIS_STORE_PATH=data/ct-analyses
