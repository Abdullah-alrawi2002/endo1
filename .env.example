# Required — get a key at https://platform.openai.com/api-keys
# Never commit .env (only this .env.example is in git).
OPENAI_API_KEY=

# Default in code if unset: gpt-4o
ENDO_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Optional: OpenAI-compatible base URL (Groq, Together, etc.)
# OPENAI_BASE_URL=
RAG_TOP_K=5
CORRECTIONS_DB_PATH=data/corrections.db
